# Ejemplo de variables de entorno del FRONTEND — COPIAR A `frontend/.env`.
# Sólo las variables que lee Vite (prefijo VITE_). El `.env` real nunca se commitea.
#
# OJO: las variables VITE_ travelan al bundle del navegador. Sólo se admiten
# valores públicos: nunca un token, una clave ni una contraseña.

# URL base del backend (el que expone /health y los endpoints de negocio).
VITE_API_BASE_URL=http://localhost:8000
