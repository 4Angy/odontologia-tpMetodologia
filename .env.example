# Ejemplo de variables de entorno — COPIAR A `.env` Y COMPLETAR.
# El `.env` real nunca se commitea (ver .gitignore).
#
# Variables canónicas de dominio (KB `knowledge-base/08_arquitectura_propuesta.md`):
# 14 en total. + 2 operativas (APP_ENV, LOG_LEVEL).
# Sin secretos reales: sólo marcadores de posición.

# --- Operativas ---------------------------------------------------------------
# dev | test | prod. En `prod` JWT_SECRET es obligatoria.
APP_ENV=dev
LOG_LEVEL=INFO

# --- Conexiones ---------------------------------------------------------------
# Dentro de compose el host es `db`; fuera de compose, `localhost`.
DATABASE_URL=postgresql+psycopg://odontologia:odontologia@db:5432/odontologia
REDIS_URL=redis://redis:6379/0

# --- Autenticación (C-03) -----------------------------------------------------
# Generar con: openssl rand -hex 32
JWT_SECRET=generar-con-openssl-rand-hex-32
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7

# --- Tenant -------------------------------------------------------------------
TENANT_DEFAULT_TZ=America/Argentina/Buenos_Aires

# --- Mensajería (ADR-001: `official` = Cloud API de Meta) ----------------------
WHATSAPP_PROVIDER=official
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# --- Mercado Pago (C-12) ------------------------------------------------------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Email fallback (C-09) ----------------------------------------------------
SMTP_URL=

# --- Varios -------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:5173
SEED_DEMO=false

# --- Sólo para compose (no las lee la app) ------------------------------------
POSTGRES_USER=odontologia
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_DB=odontologia
# Puertos publicados en el host (5432/6379/8000 pueden estar ocupados).
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
