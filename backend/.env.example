# Ejemplo de variables de entorno del BACKEND — COPIAR A `backend/.env`.
# Sólo las variables que lee la app. El `.env` real nunca se commitea.
#
# 14 variables canónicas (KB `knowledge-base/08_arquitectura_propuesta.md`),
# + 2 operativas (APP_ENV, LOG_LEVEL), + configuración opcional de adjuntos.

APP_ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://odontologia:odontologia@localhost:5432/odontologia
REDIS_URL=redis://localhost:6379/0

# Generar con: openssl rand -hex 32
JWT_SECRET=generar-con-openssl-rand-hex-32
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7

TENANT_DEFAULT_TZ=America/Argentina/Buenos_Aires

WHATSAPP_PROVIDER=official
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

SMTP_URL=

PUBLIC_BASE_URL=http://localhost:5173
# Orígenes extra permitidos por CORS (separados por coma).
# En producción incluir el dominio público, ej: https://app.consultorio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO=false

# Adjuntos clínicos (C-05): bucket privado S3-compatible; completar credenciales
# sólo en el entorno local/deploy. El backend solicita cifrado SSE-S3 (AES256).
ATTACHMENTS_S3_BUCKET=
ATTACHMENTS_S3_ENDPOINT_URL=
ATTACHMENTS_S3_REGION=us-east-1
ATTACHMENTS_S3_ACCESS_KEY_ID=
ATTACHMENTS_S3_SECRET_ACCESS_KEY=
